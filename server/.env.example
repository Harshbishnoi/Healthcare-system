# Server Environment Variables Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# JWT & Cryptographic Security
JWT_SECRET=super_secure_jwt_secret_key_healthcare_dev_2026
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# Dual Databases
MONGO_URI=mongodb://127.0.0.1:27017/doctor_patient_platform
DATABASE_URL="file:./dev.db"

# Redis Cache (Optional, defaults to in-memory fallback if offline)
REDIS_URL=redis://127.0.0.1:6379
REDIS_ENABLED=false

# Google Gemini Healthcare AI (Backend-Only)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# API Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
