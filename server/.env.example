# ==============================================================================
# DocPulse Healthcare Platform — Environment Variables & Secrets Management
# ==============================================================================
# NOTE: Never commit real production credentials or API keys to version control.
# Copy this file to '.env' and populate with your environment-specific secrets.
# ==============================================================================

# 1. Server & Runtime Environment
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# 2. Authentication & Cryptography Secrets
# Critical: Use at least a 32-character random string in production
JWT_SECRET=super_secure_jwt_secret_key_change_in_production_32bytes_min
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# 3. Document Database (MongoDB) Configuration
MONGO_URI=mongodb://127.0.0.1:27017/doctor_patient_platform
# Production MongoDB Atlas Example:
# MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/doctor_patient_platform?retryWrites=true&w=majority

# 4. Relational Database (PostgreSQL / Prisma) Configuration
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/doctor_patient_db?schema=public"
# Local SQLite Dev Option:
# DATABASE_URL="file:./dev.db"

# 5. Redis In-Memory Cache Store (Optional, auto-falls back to memory)
REDIS_URL=redis://127.0.0.1:6379
REDIS_ENABLED=false

# 6. Healthcare GenAI & LLM API (Google Gemini - Backend Only)
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# 7. API Rate Limiting & DoS Protection
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# 8. WebSockets & Real-Time Communication
SOCKET_CORS_ORIGIN=http://localhost:5173
