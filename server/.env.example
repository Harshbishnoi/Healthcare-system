# Server & Runtime Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Authentication & Cryptographic Secrets
JWT_SECRET=your_super_secret_jwt_key_min_32_characters_here
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# MongoDB Document Database Connection (Clinical Store)
MONGO_URI=mongodb://127.0.0.1:27017/doctor_patient_platform
MONGODB_URI=mongodb://127.0.0.1:27017/doctor_patient_platform

# PostgreSQL Relational Database Connection (Prisma Store)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
DB_NAME=doctor_patient_db
DATABASE_URL="postgresql://postgres:your_postgres_password_here@localhost:5432/doctor_patient_db?schema=public"

# Payment Gateway Integration (Stripe)
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here

# Redis In-Memory Cache Configuration (Optional, fallback enabled)
REDIS_URL=redis://127.0.0.1:6379
REDIS_ENABLED=false

# Google Gemini Healthcare GenAI (Backend-Only Execution)
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# API Rate Limiting & DoS Protection
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
