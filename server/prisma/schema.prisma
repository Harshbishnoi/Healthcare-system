// Prisma Schema for Relational PostgreSQL Database, Audit Logs, Transactions, RAG Vectors, and AI Analytics
// Doctor–Patient Healthcare Platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 1. Relational Doctor Profile Entity
model Doctor {
  id              String   @id @default(uuid())
  mongoDoctorId   String?  @unique
  name            String
  email           String   @unique
  specialization  String
  experienceYears Int      @default(0)
  hospitalClinic  String
  city            String
  consultationFee Float    @default(500.0)
  ratingAvg       Float    @default(5.0)
  totalReviews    Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relational Foreign Key Links for SQL JOINs
  appointments    Appointment[]
  reviews         DoctorReview[]
  metrics         DoctorMetric?
  medicalRecords  MedicalRecord[]

  @@index([specialization])
  @@index([city])
  @@index([ratingAvg])
}

// 2. Relational Patient Profile Entity
model Patient {
  id               String   @id @default(uuid())
  mongoPatientId   String?  @unique
  name             String
  email            String   @unique
  mobile           String
  city             String
  bloodGroup       String?
  healthConcern    String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relational Foreign Key Links for SQL JOINs
  appointments     Appointment[]
  reviews          DoctorReview[]
  medicalRecords   MedicalRecord[]

  @@index([city])
}

// 3. Relational Appointment Entity (Central JOIN Table)
model Appointment {
  id                 String   @id @default(uuid())
  mongoAppointmentId String   @unique
  appointmentDate    DateTime
  timeSlot           String
  status             String   @default("pending") // pending, confirmed, completed, cancelled
  mode               String   @default("offline") // online, offline
  consultationFee    Float    @default(500.0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Relational Foreign Key Relations for SQL JOINs
  doctorId           String
  doctor             Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  patientId          String
  patient            Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  consultation       Consultation?
  payment            PaymentTransaction?

  @@index([doctorId])
  @@index([patientId])
  @@index([appointmentDate])
  @@index([status])
}

// 4. Relational Consultation Entity (Joined with Appointment)
model Consultation {
  id                  String      @id @default(uuid())
  mongoConsultationId String?     @unique
  diagnosis           String
  clinicalNotes       String
  treatmentPlan       String?
  vitalsBp            String?
  vitalsPulse         String?
  vitalsTemp          String?
  followUpDate        DateTime?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  // Relational Foreign Key Link (1-to-1 with Appointment)
  appointmentId       String      @unique
  appointment         Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([diagnosis])
  @@index([createdAt])
}

// 5. Relational Payment Transaction Entity (Joined with Appointment)
model PaymentTransaction {
  id              String      @id @default(uuid())
  transactionId   String      @unique
  amount          Float
  currency        String      @default("USD")
  status          String      @default("succeeded") // pending, succeeded, failed, refunded
  paymentMethod   String      @default("card")
  receiptNumber   String      @unique
  paidAt          DateTime    @default(now())

  // Relational Foreign Key Link
  appointmentId   String      @unique
  appointment     Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([paidAt])
}

// 6. Relational Doctor Review Entity (Joined with Doctor and Patient)
model DoctorReview {
  id          String   @id @default(uuid())
  rating      Int      @default(5)
  comment     String
  isAnonymous Boolean  @default(false)
  createdAt   DateTime @default(now())

  // Relational Foreign Key Links
  doctorId    String
  doctor      Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  patientId   String
  patient     Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([doctorId])
  @@index([patientId])
  @@index([rating])
}

// 7. Aggregated Metrics Entity
model DoctorMetric {
  id                    String   @id @default(uuid())
  doctorId              String   @unique
  doctor                Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  totalAppointments     Int      @default(0)
  completedAppointments Int      @default(0)
  cancelledAppointments Int      @default(0)
  revenueSum            Float    @default(0.0)
  averageRating         Float    @default(5.0)
  reviewCount           Int      @default(0)
  lastUpdated           DateTime @default(now()) @updatedAt

  @@index([doctorId])
}

// 8. Relational User Audit Log
model UserAuditLog {
  id        String   @id @default(uuid())
  userId    String
  role      String
  action    String
  ipAddress String?
  userAgent String?
  metadata  String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

// 9. Daily Platform Metric Rollup
model PlatformMetric {
  id                   String   @id @default(uuid())
  reportDate           DateTime @default(now())
  totalBookings        Int      @default(0)
  activeDoctors        Int      @default(0)
  activePatients       Int      @default(0)
  onlineConsultations  Int      @default(0)
  offlineConsultations Int      @default(0)
  totalRevenue         Float    @default(0.0)
  topSpecialization    String?

  @@index([reportDate])
}

// 10. Medical Records & Lab Uploads Entity (Problem Modeling & File Uploads)
model MedicalRecord {
  id             String   @id @default(uuid())
  patientId      String
  patient        Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId       String?
  doctor         Doctor?  @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  title          String
  recordType     String   @default("lab_report") // lab_report, prescription, radiology_scan, discharge_summary
  fileUrl        String
  fileName       String
  fileSize       Int      @default(0) // bytes
  mimeType       String   @default("application/pdf")
  isConfidential Boolean  @default(false)
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([patientId])
  @@index([doctorId])
  @@index([recordType])
  @@index([createdAt])
}

// 11. AI Token & Cost Monitoring Log Entity
model AiTokenUsage {
  id                String   @id @default(uuid())
  userId            String?
  model             String
  promptTokens      Int      @default(0)
  completionTokens  Int      @default(0)
  totalTokens       Int      @default(0)
  estimatedCostUsd  Float    @default(0.0)
  feature           String   @default("triage") // triage, doctor_search, rag_query, multi_step_agent, stream_triage
  latencyMs         Int      @default(0)
  status            String   @default("success") // success, error, filtered
  createdAt         DateTime @default(now())

  @@index([userId])
  @@index([model])
  @@index([feature])
  @@index([createdAt])
}

// 12. RAG Medical Knowledge Base Document Entity (Vector Retrieval)
model KnowledgeDocument {
  id                   String   @id @default(uuid())
  title                String
  category             String   // emergency_triage, cardiology, pediatrics, dermatology, pharmacology
  chunkText            String
  vectorEmbeddingJson  String   // JSON serialized float array vector
  source               String   // WHO, CDC, AHA, Stanford Clinical Guidelines
  keywords             String?
  createdAt            DateTime @default(now())

  @@index([category])
  @@index([title])
}

// 13. Multi-Step Autonomous Agent Execution Log Entity
model AgentExecutionLog {
  id              String   @id @default(uuid())
  sessionId       String
  userId          String?
  goal            String
  stepsJson       String   // JSON serialized array of ReAct steps (Thought, Action, Observation)
  finalResult     String
  totalSteps      Int      @default(0)
  totalTokens     Int      @default(0)
  totalCostUsd    Float    @default(0.0)
  executionTimeMs Int      @default(0)
  createdAt       DateTime @default(now())

  @@index([sessionId])
  @@index([userId])
  @@index([createdAt])
}
