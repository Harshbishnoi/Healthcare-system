# ==============================================================================
# DocPulse Healthcare Platform — Environment Variables & Secrets Management
# ==============================================================================
# Security Notice:
# 1. Never commit active credentials, production API keys, or database passwords.
# 2. Duplicate this file as '.env' in your local environment.
# 3. All secrets in production must be injected via secure CI/CD or platform env vaults.
# ==============================================================================

# Server & Runtime Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Authentication & Cryptographic Secrets
# Generate using a 32+ character high-entropy random string (e.g. `openssl rand -hex 32`)
JWT_SECRET=your_super_secret_jwt_key_min_32_characters_here
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10
SESSION_SECRET=your_session_secret_key_here
ADMIN_SECRET=your_admin_secret_passphrase_here

# MongoDB Document Database Connection (Clinical Store)
MONGO_URI=mongodb://127.0.0.1:27017/doctor_patient_platform
MONGODB_URI=mongodb://127.0.0.1:27017/doctor_patient_platform

# PostgreSQL Relational Database Connection (Prisma Store)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/doctor_patient_db?schema=public"

# Redis In-Memory Cache Configuration (Optional, fallback enabled)
REDIS_URL=redis://127.0.0.1:6379
REDIS_ENABLED=false

# Google Gemini Healthcare GenAI (Backend-Only Execution)
GEMINI_API_KEY=your_google_gemini_api_key_here
GOOGLE_GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# API Rate Limiting & DoS Protection
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# WebSockets & Real-Time Communication
SOCKET_CORS_ORIGIN=http://localhost:5173

# Frontend Vite Client Configuration
VITE_API_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000
