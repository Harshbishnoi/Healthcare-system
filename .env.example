# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Authentication & Security
JWT_SECRET=super_secure_jwt_secret_key_change_in_production_32bytes_min
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# MongoDB Connection
MONGO_URI=mongodb://127.0.0.1:27017/doctor_patient_platform
# Alternative cloud URI:
# MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/doctor_patient_platform?retryWrites=true&w=majority

# PostgreSQL Connection (Prisma)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/doctor_patient_db?schema=public
# Or for local development with SQLite fallback:
# DATABASE_URL=file:./dev.db

# AI / LLM Configuration
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
