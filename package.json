{
  "name": "doctor-patient-platform",
  "version": "1.0.0",
  "description": "Production-grade Doctor-Patient Healthcare Web Application",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "server:dev": "npm --prefix server run dev",
    "client:dev": "npm --prefix client run dev",
    "server:start": "npm --prefix server start",
    "client:build": "npm --prefix client run build",
    "install:all": "npm install && npm --prefix server install && npm --prefix client install",
    "test": "npm --prefix server test",
    "ssr": "npm --prefix server start",
    "build:ssr": "npm --prefix client run build:ssr",
    "prisma:generate": "npm --prefix server run prisma:generate",
    "prisma:push": "npm --prefix server run prisma:push"
  },
  "keywords": [
    "healthcare",
    "doctor-patient",
    "react",
    "express",
    "mongodb",
    "postgresql",
    "prisma",
    "ai",
    "ssr"
  ],
  "author": "Harsh Bishnoi",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
